---
import { chapters, lessonPath } from '../data/course';

interface Props {
  chapterSlug: string;
  lessonSlug: string;
}
const { chapterSlug, lessonSlug } = Astro.props;

const chapter = chapters.find((c) => c.slug === chapterSlug);
const idx = chapter?.lessons.findIndex((l) => l.slug === lessonSlug) ?? -1;
const prev = chapter && idx > 0 ? chapter.lessons[idx - 1] : null;
const next = chapter && idx < (chapter.lessons.length - 1) ? chapter.lessons[idx + 1] : null;
---

<nav class="mt-16 flex items-stretch justify-between gap-4 border-t border-ink-700/50 pt-8">
  {prev ? (
    <a
      href={lessonPath(chapterSlug, prev.slug)}
      class="group flex-1 rounded-xl border border-ink-700/50 bg-ink-900/40 px-5 py-4 hover:border-accent/40 hover:bg-ink-800/60 transition"
    >
      <div class="text-xs text-ink-300">← Previous</div>
      <div class="mt-1 font-medium text-ink-50 group-hover:text-accent transition-colors">{prev.title}</div>
    </a>
  ) : <div class="flex-1"></div>}

  {next ? (
    <a
      href={lessonPath(chapterSlug, next.slug)}
      class="group flex-1 rounded-xl border border-ink-700/50 bg-ink-900/40 px-5 py-4 text-right hover:border-accent/40 hover:bg-ink-800/60 transition"
    >
      <div class="text-xs text-ink-300">Next →</div>
      <div class="mt-1 font-medium text-ink-50 group-hover:text-accent transition-colors">{next.title}</div>
    </a>
  ) : <div class="flex-1"></div>}
</nav>
