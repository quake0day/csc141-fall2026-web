---
import Site from '../../../layouts/Site.astro';
import KCBadge from '../../../components/KCBadge.astro';
import { chapters, lessonPath } from '../../../data/course';

const chapter = chapters.find((c) => c.slug === '07-file-io')!;
const kindLabel: Record<string, string> = { example: 'Worked Example', exercise: 'Exercise', homework: 'Homework', challenge: 'Challenge' };
const kindColor: Record<string, string> = {
  example: 'bg-accent-mint/15 text-accent-mint ring-accent-mint/30',
  exercise: 'bg-accent/15 text-accent ring-accent/30',
  homework: 'bg-accent-warm/15 text-accent-warm ring-accent-warm/30',
  challenge: 'bg-accent-warm/15 text-accent-warm ring-accent-warm/30',
};
---
<Site title={chapter.title}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-10">
    <div class="text-xs font-mono uppercase tracking-[0.18em] text-ink-300">Chapter 07</div>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-ink-50 sm:text-5xl">{chapter.title}</h1>
    <p class="mt-1 font-serif text-xl italic text-ink-200">{chapter.title_zh}</p>
    <p class="mt-5 max-w-prose text-[17px] leading-[1.75] text-ink-100/90">{chapter.summary}</p>
    <p class="mt-4 text-sm text-ink-300">Strict source: <span class="text-accent-mint">Automate the Boring Stuff with Python ch.9</span></p>
    <p class="mt-2 text-xs text-ink-300/80">Note: Browser playgrounds can't open real files (sandbox). Run lessons in WolfCode locally to test file I/O end-to-end.</p>

    <h2 class="mt-12 text-sm font-mono uppercase tracking-[0.18em] text-ink-300">Lessons in this chapter</h2>
    <ol class="mt-4 space-y-3">
      {chapter.lessons.map((lesson, i) => (
        <li>
          <a href={lessonPath(chapter.slug, lesson.slug)} class="group flex items-center justify-between gap-6 rounded-xl border border-ink-700/50 bg-ink-900/40 px-5 py-4 transition hover:border-accent/40 hover:bg-ink-800/60">
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono text-ink-300">07.{String(i).padStart(2, '0')}</span>
                <span class={`rounded px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider ring-1 ${kindColor[lesson.kind]}`}>{kindLabel[lesson.kind]}</span>
              </div>
              <div class="mt-1 text-lg font-medium text-ink-50 group-hover:text-accent transition-colors">{lesson.title}</div>
              <div class="mt-0.5 font-serif text-sm italic text-ink-200">{lesson.title_zh}</div>
            </div>
            <div class="flex flex-col items-end gap-2">
              <div class="flex flex-wrap items-center gap-1.5">{lesson.kc.map((kc) => <KCBadge kc={kc} />)}</div>
              <span class="text-xs text-ink-300">{lesson.estimated_minutes} min</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Site>
